{
  "about": "Docs-only git guard cases, run after guard-git.cases.json (shared: do not edit it here). A case with the same command and branch as a shared one replaces it. fixture_files are added to the shared ones; fixture_config is set in both scratch repos and fixture_config_main only in the main one (saved aliases, for the alias cases). A case's optional `cwd` is sent as the payload's cwd.",
  "fixture_files": [
    "index.mdx",
    "docs.json"
  ],
  "cases": [
    {
      "command": "git checkout -- index.mdx",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git checkout docs.json 2>/dev/null",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git restore index.mdx",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git rebase --no-verify x",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "GIT_DIR=.git git push --force",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "gh pr create --body \"never git push --force\"",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "gh pr comment 261 --body 'git checkout -- . discards work'",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git push -u origin claude/x",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git reset HEAD index.mdx",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git checkout -b feat/x origin/main",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git restore --staged index.mdx",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "python3 scripts/validate-docs.py",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git fp origin claude/x",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git rh",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git sh",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git loop",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git st",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git status",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git log -1",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git -C {main_repo} mainfp origin claude/x",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git mainfp origin claude/x",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "cd {main_repo} && git mainfp origin claude/x",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git --git-dir={main_repo}/.git mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "GIT_DIR={main_repo}/.git git mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -C \"$PWD\" fp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -c alias.a=b -c 'alias.b=push --force' a",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -c alias.a=a a",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "cd {main_repo} && git status",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "GIT_DIR=.git git log -1",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git -C {main_repo} mainfp2 origin claude/x",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "cd {main_repo} && bash -c \"git mainfp\"",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "GIT_DIR={main_repo}/.git bash -c \"git mainfp\"",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "cd {main_repo} && echo \"git mainfp\" | bash",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "eval 'cd {main_repo}' && git mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -C {main_repo}* mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -C ../no-such-repo mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ -c alias.a=b -c alias.b=c -c alias.c=d -c alias.d=_ a; git push --force origin main",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git add . && git log -1",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "GIT_PAGER=cat git log -1",
      "expect": "allow",
      "branch": "claude/test"
    },
    {
      "command": "git mainfp origin claude/x",
      "expect": "deny",
      "branch": "claude/test",
      "cwd": "{main_repo}"
    },
    {
      "command": "git -C {main_repo} shmainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git -c 'alias.b=push --force' -c 'alias.a=!git b' a",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": ". ./env.sh && git mainfp",
      "expect": "deny",
      "branch": "claude/test"
    },
    {
      "command": "git add . && git status",
      "expect": "allow",
      "branch": "claude/test"
    }
  ],
  "fixture_config": {
    "alias.fp": "push --force",
    "alias.rh": "reset --hard",
    "alias.sh": "!git push -f",
    "alias.st": "status",
    "alias.status": "reset --hard",
    "alias.loop": "loop"
  },
  "fixture_config_main": {
    "alias.mainfp": "push --force",
    "alias.mainfp2": "mainfp",
    "alias.shmainfp": "!git mainfp"
  }
}
