#!/usr/bin/env bash
# The quick checks CI's "Validate docs site" job runs, in about a second.
# Turn it on once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/test-validate-docs.py >/dev/null
python3 scripts/validate-docs.py
python3 scripts/check-house-spelling.py
python3 .claude/hooks/test-guard-git.py >/dev/null
